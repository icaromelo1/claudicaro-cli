generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id                  String         @id @default(cuid())
  title               String         @default("Nova conversa")
  orchestratorConfig  String?
  deletedAt           DateTime?
  pinnedAt            DateTime?
  groupId             String?
  workingDir          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  messages            Message[]
  memories            Memory[]
  agentSnaps          AgentSnapshot[]
  cliSessions         CliSession[]
  canvasCards         CanvasCard[]
  canvasLinks         CanvasLink[]
  peerGroups          PeerGroup[]
  group               SessionGroup?  @relation(fields: [groupId], references: [id])
}

model SessionGroup {
  id        String    @id @default(cuid())
  name      String
  color     String    @default("#3FCF8E")
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model CliSession {
  id               String   @id @default(cuid())
  icarusSessionId  String
  cli              String
  cliSessionId     String
  msgIndex         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  session          Session  @relation(fields: [icarusSessionId], references: [id], onDelete: Cascade)

  @@unique([icarusSessionId, cli])
}

model Message {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String   // "user" | "assistant"
  content     String
  cli         String?  // "claude" | "gemini" | "copilot" | null
  model       String?  // modelo usado
  routingMeta String?  // JSON: motivo do roteamento
  tokens      Int?     // tokens usados
  latencyMs   Int?     // latência em ms
  createdAt   DateTime @default(now())
}

model Memory {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key         String   // ex: "agents/especialista-deposito"
  content     String   // conteúdo do .agent/*.md
  rev         String?  // timestamp/hash de revisão
  updatedAt   DateTime @updatedAt
}

model AgentSnapshot {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentFile   String   // caminho do arquivo .agent/*.md
  content     String   // snapshot do conteúdo naquele momento
  createdAt   DateTime @default(now())
}

model LockEntry {
  id              String   @id @default(cuid())
  phase           String
  ownerCli        String
  ownerUser       String
  startTime       DateTime
  estimatedEnd    DateTime
  intent          String
  filesInScope    String   // JSON array
  sharedResources String   // JSON array
  status          String   @default("in_progress") // "in_progress" | "done" | "blocked"
  blockingReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CanvasCard {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cli       String
  label     String?
  engine    String   @default("pty") // "pty" | "headless-task" | "headless-peer"
  x         Float
  y         Float
  width     Float    @default(480)
  height    Float    @default(360)
  ptyAlive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PeerGroup {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnOrder    String   @default("roundtable") // "round-robin" | "roundtable"
  maxRounds    Int      @default(5)
  currentRound Int      @default(0)
  status       String   @default("running") // "running" | "stopped" | "done"
  createdAt    DateTime @default(now())
  members      PeerGroupMember[]
}

model PeerGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     PeerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cardId    String
  turnIndex Int
}

model PeerTurn {
  id        String   @id @default(cuid())
  groupId   String
  cardId    String
  round     Int
  content   String
  createdAt DateTime @default(now())
}

model CanvasLink {
  id             String   @id @default(cuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fromCardId     String
  toCardId       String
  contextSummary String
  createdAt      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "force_unlock" | "lock_created" | "lock_released"
  phase     String?
  actor     String   // CLI ou usuário
  reason    String?
  metadata  String?  // JSON extra
  createdAt DateTime @default(now())
}
